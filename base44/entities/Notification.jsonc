{
  "name": "Notification",
  "type": "object",
  "description": "In app notification. recipient_email is the addressee. Community notifications are written by notifyCircle with the service role and never carry the identity of an anonymous poster.",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "comment",
        "mention",
        "reply",
        "tool_complete",
        "module_unlock",
        "like",
        "follow",
        "new_badge",
        "level_up",
        "post_reshare",
        "circle_join_request",
        "circle_approved",
        "circle_declined",
        "circle_reply",
        "circle_answered",
        "circle_new_question",
        "circle_report"
      ]
    },
    "message": {
      "type": "string"
    },
    "linkTo": {
      "type": "string"
    },
    "isRead": {
      "type": "boolean",
      "default": false
    },
    "recipient_email": {
      "type": "string",
      "description": "Who this notification is for"
    },
    "source_user_email": {
      "type": "string",
      "description": "Who triggered this notification. Empty when the trigger was an anonymous post."
    },
    "target_post_id": {
      "type": "string"
    },
    "target_comment_id": {
      "type": "string"
    },
    "group_id": {
      "type": "string",
      "description": "Room the notification belongs to, for community types"
    }
  },
  "required": [
    "type",
    "message"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.source_user_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.source_user_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.source_user_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}