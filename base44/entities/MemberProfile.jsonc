{
  "name": "MemberProfile",
  "properties": {
    "affiliate_id": {
      "description": "GoAffPro affiliate ID captured at signup",
      "type": "string"
    },
    "completed_modules_count": {
      "default": 0,
      "description": "Total modules user has marked complete across all courses",
      "type": "number"
    },
    "computed_archetype_key": {
      "description": "User's archetype key from onboarding quiz. Null until quiz is completed.",
      "enum": [
        "performer",
        "over_functioner",
        "delegator",
        "overrider",
        "reactor"
      ],
      "type": "string"
    },
    "current_phase": {
      "default": "awareness",
      "description": "Current ALIVE phase the user is in",
      "enum": [
        "awareness",
        "liberation",
        "intentional_action",
        "vision",
        "embodiment"
      ],
      "type": "string"
    },
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "first_name": {
      "description": "User's first name, used for dashboard greeting",
      "type": "string"
    },
    "full_name": {
      "description": "User's full name",
      "type": "string"
    },
    "has_seen_welcome": {
      "default": false,
      "description": "Flips to true after the user's first dashboard load",
      "type": "boolean"
    },
    "last_module_id": {
      "description": "Reference to the most recent Module the user accessed. Null if no module accessed yet.",
      "type": "string"
    },
    "latest_attempt_id": {
      "description": "ProfileAttempt id of her latest attempt",
      "type": "string"
    },
    "next_step_route": {
      "description": "Route picked on Your Pattern: Blueprint or one-on-one",
      "enum": [
        "bp",
        "laura"
      ],
      "type": "string"
    },
    "pattern_section_seen_at": {
      "description": "First time the Your Pattern page was shown after her latest attempt",
      "format": "date-time",
      "type": "string"
    },
    "profile_image_url": {
      "description": "URL to profile image",
      "type": "string"
    },
    "quiz_completed_at": {
      "description": "Timestamp when the user completed the onboarding quiz. Null until completed.",
      "format": "date-time",
      "type": "string"
    },
    "quiz_fit": {
      "description": "Her answer to Does this sound like you?",
      "enum": [
        "yes",
        "partly",
        "not_really"
      ],
      "type": "string"
    },
    "quiz_guess": {
      "description": "The pattern she guessed before seeing her result",
      "enum": [
        "performer",
        "over_functioner",
        "delegator",
        "overrider",
        "reactor",
        "unsure"
      ],
      "type": "string"
    },
    "quiz_image_variant": {
      "description": "Which pattern photograph she was shown, so it stays the same",
      "type": "string"
    },
    "quiz_mix": {
      "description": "Pattern mix percentages per platform key, adding to 100. Stored only, never shown",
      "type": "object"
    },
    "quiz_source": {
      "description": "Where she took the profile from, e.g. summit",
      "type": "string"
    },
    "referral_source": {
      "description": "How the user found the platform",
      "type": "string"
    },
    "secondary_archetype_key": {
      "description": "Second strongest pattern from her latest Starting Point Profile",
      "enum": [
        "performer",
        "over_functioner",
        "delegator",
        "overrider",
        "reactor"
      ],
      "type": "string"
    },
    "signup_timestamp": {
      "description": "When the profile was created",
      "format": "date-time",
      "type": "string"
    },
    "user_id": {
      "description": "Foreign key to User. One MemberProfile per User.",
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}