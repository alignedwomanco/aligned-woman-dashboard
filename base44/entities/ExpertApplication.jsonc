{
  "name": "ExpertApplication",
  "type": "object",
  "description": "Public applications to join the directory as a practitioner or a business, and optionally to host a community room. Created from /Apply or the Start your own group form on Community, reviewed by an admin on the Applications screen, and actioned by approvePartnerApplication, which creates the linked Expert record, applies grants, and creates a draft room when community hosting is granted. applicant_name and email are always the person who will own the listing or host the room; requested_by_* records who sent the request when that was someone else. Affiliate, course host and community host access are granted selectively by the admin, never automatically, and this flow never grants Blueprint course access.",
  "properties": {
    "applicant_name": {
      "type": "string",
      "description": "Applicant full name (the person who will host or be listed)"
    },
    "business_name": {
      "type": "string",
      "description": "Business name, if applying as a business"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Applicant contact and login email (the host's login email for a room)"
    },
    "requested_by_name": {
      "type": "string",
      "description": "Name of the logged in member who sent the request, when the host is someone else"
    },
    "requested_by_email": {
      "type": "string",
      "description": "Email of the logged in member who sent the request, when the host is someone else"
    },
    "headline": {
      "type": "string",
      "description": "Title or role they want displayed on their profile"
    },
    "bio": {
      "type": "string",
      "description": "Short biography"
    },
    "profile_picture": {
      "type": "string",
      "description": "Profile image URL"
    },
    "logo_url": {
      "type": "string",
      "description": "Business logo URL, for business applications"
    },
    "website_url": {
      "type": "string",
      "description": "Website URL"
    },
    "instagram_url": {
      "type": "string",
      "description": "Instagram URL"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn URL"
    },
    "category_interest": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Category names or ids the applicant is interested in"
    },
    "application_type": {
      "type": "string",
      "enum": [
        "individual",
        "business"
      ],
      "default": "individual",
      "description": "Applying as an individual or a business"
    },
    "interested_in": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What they are applying for. Allowed values: marketplace_profile, affiliate, host_course, host_community"
    },
    "community_name": {
      "type": "string",
      "description": "If hosting a community: what it would be called"
    },
    "community_for": {
      "type": "string",
      "description": "If hosting a community: who it is for"
    },
    "community_topics": {
      "type": "string",
      "description": "If hosting a community: what women would talk about"
    },
    "message": {
      "type": "string",
      "description": "Free-text note from the applicant"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Review status"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the application was reviewed"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin email who actioned it"
    },
    "review_notes": {
      "type": "string",
      "description": "Admin notes from the review, or the decline reason"
    },
    "created_expert_id": {
      "type": "string",
      "description": "Id of the Expert record created on approval"
    },
    "created_group_id": {
      "type": "string",
      "description": "Id of the draft room created on approval when community hosting was granted"
    },
    "granted_affiliate": {
      "type": "boolean",
      "default": false,
      "description": "Whether affiliate access was granted at approval"
    },
    "granted_course_host": {
      "type": "boolean",
      "default": false,
      "description": "Whether course hosting was granted at approval"
    },
    "granted_community_host": {
      "type": "boolean",
      "default": false,
      "description": "Whether community hosting was granted at approval"
    }
  },
  "required": [
    "applicant_name",
    "email",
    "application_type"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}