{
  "name": "GroupPost",
  "type": "object",
  "description": "The ambient conversation inside a group. Replies nest one level only, via parent_id. No likes, no reactions, no points. Posts are written only by createCirclePost with the service role and read only through getCirclePosts, which strips identity from anonymous posts for everyone except the host and admins. No browser write path exists, so nobody can insert a post with a forged author or host flag, and no browser read path exists, so a later page regression cannot expose posts.",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "Group this post belongs to"
    },
    "body": {
      "type": "string",
      "description": "Post text"
    },
    "parent_id": {
      "type": "string",
      "description": "Empty for a top level post, or the id of the post being replied to. Replies nest one level only."
    },
    "author_name": {
      "type": "string",
      "description": "Display name captured at post time. For an anonymous post this holds Anonymous member, never the real name."
    },
    "author_avatar": {
      "type": "string",
      "description": "Author avatar URL at time of posting. Empty for anonymous posts."
    },
    "author_is_practitioner": {
      "type": "boolean",
      "default": false,
      "description": "Author is an AW Verified practitioner, so the card can mark them"
    },
    "author_is_host": {
      "type": "boolean",
      "description": "Author is the host of this room"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete. Removed posts leave the thread structure intact rather than orphaning their replies."
    },
    "post_type": {
      "type": "string",
      "enum": [
        "question",
        "share",
        "welcome"
      ],
      "description": "question is Ask a question, share is Share, welcome is the host's pinned welcome post. Treat empty as share."
    },
    "is_anonymous": {
      "type": "boolean",
      "description": "Other members see Anonymous member. The host and admins see the real identity via author_email_private."
    },
    "author_email_private": {
      "type": "string",
      "description": "Real author email. Only ever returned by getCirclePosts to the host and admins. Never rendered to members."
    },
    "author_name_private": {
      "type": "string",
      "description": "Real author name. Only ever returned by getCirclePosts and moderateCircle to the host and admins."
    },
    "anon_tint": {
      "type": "number",
      "description": "0 to 5, chosen at random per post so anonymous avatars cannot be linked by colour"
    },
    "topic_key": {
      "type": "string",
      "description": "Key of the topic from Group.topics"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "answered"
      ],
      "description": "Question state. Set to answered when the host replies or marks it. Treat empty as open."
    },
    "is_pinned": {
      "type": "boolean",
      "description": "Pinned to the top of the feed"
    },
    "answered_by": {
      "type": "string",
      "description": "Email of the host who answered or marked this answered"
    },
    "answered_at": {
      "type": "string",
      "format": "date-time"
    },
    "answer_post_id": {
      "type": "string",
      "description": "The host reply pinned as the answer"
    },
    "media": {
      "type": "array",
      "description": "Attached files on our own file host, re-encoded and renamed in the browser before upload so no EXIF or original file name survives",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "audio"
            ]
          },
          "url": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number"
          }
        }
      }
    },
    "reply_count": {
      "type": "number",
      "description": "Denormalised count of live replies, kept by createCirclePost"
    }
  },
  "required": [
    "group_id",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}