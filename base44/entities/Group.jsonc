{
  "name": "Group",
  "type": "object",
  "description": "A community room. Interest groups are created by an admin and open to any registered member. Private groups are created by members and invite only. Event groups are populated from a ticket list. A partner hosted room (host_expert_id set) lives at its own slug as a top level address, is request to join, and is invisible until status is published.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name, for example The Grounded Women Circle"
    },
    "slug": {
      "type": "string",
      "description": "URL segment. For a partner room this is the room's public address, for example groundedwomen at app.alignedwomanco.com/groundedwomen. Unique. Validated against the reserved word list in src/lib/roomSlug.js."
    },
    "subtitle": {
      "type": "string",
      "description": "One line under the room name in the header, for example Grounded women. Still growing. Still living."
    },
    "blurb": {
      "type": "string",
      "description": "One line shown on cards and under the group name"
    },
    "description": {
      "type": "string",
      "description": "Longer About copy for the group page. For a partner room this is the room intro shown in the feed."
    },
    "cover_image": {
      "type": "string",
      "description": "Optional cover image URL. Falls back to a brand gradient when empty."
    },
    "logo_url": {
      "type": "string",
      "description": "Optional room mark, shown as a circle in the room header and beside host posts. Falls back to the host's own logo, then to initials."
    },
    "group_type": {
      "type": "string",
      "enum": [
        "interest",
        "private",
        "event"
      ],
      "description": "interest is admin created and open, private is member created and invite only, event is populated from an attendee list"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "secret"
      ],
      "description": "public is listed and joinable, private is listed and join by request, secret is invisible unless invited"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive groups are hidden from Discover but remain readable to members"
    },
    "member_count": {
      "type": "number",
      "default": 0,
      "description": "Denormalised count, kept in step by the join and leave actions so cards do not have to aggregate GroupMember on every render"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Sort order in Discover, ascending"
    },
    "host_expert_id": {
      "type": "string",
      "description": "Expert record of the partner hosting this room. Empty for Aligned Woman Co. rooms."
    },
    "host_bio_override": {
      "type": "string",
      "description": "Optional host line shown on the host card in place of the Expert bio"
    },
    "rules_text": {
      "type": "string",
      "description": "The room rules, shown in the rules modal and agreed to at the join gate"
    },
    "topics": {
      "type": "array",
      "description": "Topics members tag posts with. Data, not code, so the host can edit them without a developer.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "accent_token": {
      "type": "string",
      "description": "Tailwind colour token name for the room accent, for example sage. Never a hex."
    },
    "is_sensitive": {
      "type": "boolean",
      "description": "Room holds intimate or health conversation. Anonymous posting is offered and identities are stripped server side."
    },
    "access_mode": {
      "type": "string",
      "enum": [
        "open",
        "request",
        "invite"
      ],
      "description": "open joins immediately, request writes a pending membership for the host to approve, invite is by link only"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "description": "Draft rooms are invisible to everyone but the host and admins. Treat an empty value as published for legacy rooms. No default, because a field carrying both enum and default is rejected by the schema API."
    },
    "live_session": {
      "type": "object",
      "description": "The host's recurring live hour: one time a week she is in the room. Times are South African time (SAST, UTC+2, no daylight saving). The next occurrence is computed in the reader's browser, so there is no stored date to drift and no scheduled job.",
      "properties": {
        "on": {
          "type": "boolean",
          "default": false,
          "description": "Whether the weekly live hour is shown in the room"
        },
        "day": {
          "type": "number",
          "description": "Day of the week in SAST, 0 is Sunday through 6 is Saturday"
        },
        "start_time": {
          "type": "string",
          "description": "Start time in SAST, 24 hour HH:MM"
        },
        "duration_minutes": {
          "type": "number",
          "default": 60,
          "description": "How long the session runs, in minutes"
        },
        "label": {
          "type": "string",
          "description": "What the host calls her hour. Default Circle Hour."
        }
      }
    },
    "welcome_post_id": {
      "type": "string",
      "description": "GroupPost id of the pinned welcome post written by the host at setup"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}