{
  "name": "Application",
  "properties": {
    "acknowledges_price": {
      "type": "boolean"
    },
    "age_range": {
      "enum": [
        "Under 20",
        "20\u201325",
        "26\u201330",
        "31\u201335",
        "36\u201340",
        "41\u201345",
        "46+"
      ],
      "type": "string"
    },
    "answer_1": {
      "description": "What's happening for you right now that made you choose this?",
      "type": "string"
    },
    "answer_2": {
      "description": "What would be different in six months if this worked?",
      "type": "string"
    },
    "confirms_reservation": {
      "type": "boolean"
    },
    "country_city": {
      "type": "string"
    },
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "email": {
      "format": "email",
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "instagram_handle": {
      "type": "string"
    },
    "payment_preference": {
      "enum": [
        "Pay in full",
        "Payment plan"
      ],
      "type": "string"
    },
    "primary_focus": {
      "type": "string"
    },
    "primary_focus_other": {
      "type": "string"
    },
    "primary_key": {
      "enum": [
        "performer",
        "over_functioner",
        "delegator",
        "overrider",
        "reactor"
      ],
      "type": "string"
    },
    "programme": {
      "description": "one_on_one for Starting Point Profile applications. Blank means a Blueprint application",
      "enum": [
        "one_on_one"
      ],
      "type": "string"
    },
    "secondary_key": {
      "enum": [
        "performer",
        "over_functioner",
        "delegator",
        "overrider",
        "reactor"
      ],
      "type": "string"
    },
    "source": {
      "description": "Where she took the profile from",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "type": "string"
    },
    "understands_paid_programme": {
      "type": "boolean"
    },
    "user_id": {
      "description": "Her account",
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "type": "object",
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}