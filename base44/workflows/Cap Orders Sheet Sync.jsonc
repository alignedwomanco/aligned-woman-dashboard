{
  "description": "Refreshes the Google Sheet of everyone who has ordered caps, with their full order details.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Cap Orders Sheet Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cap_orders_sheet_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_cap_orders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncCapOrdersToSheet",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh the cap orders sheet",
            "description": "Writes every cap order"
          }
        }
      }
    ]
  }
}