{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "compute_workbook_scores_on_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "computeWorkbookScoresOnComplete",
            "args": {
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Score the completed workbook",
            "description": "Writes her computed results"
          }
        }
      }
    ]
  },
  "description": "Scores a member's workbook the moment she marks it complete, so her results and portraits are ready when she opens them.",
  "name": "Compute Workbook Scores on Completion",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"is_complete\") != null) and (.trigger.data.is_complete == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "WorkbookResponse"
    }
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "computeWorkbookScores"
  }
}